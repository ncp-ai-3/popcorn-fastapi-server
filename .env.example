# PostgreSQL (graph/db.py, graph/nodes_retrieval.py)
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=5432

# RAG: pgvector 코사인 거리(<=>)가 이 값 미만인 팝업만 후보, 거리 순 최대 3개
# RAG_COSINE_DISTANCE_MAX=0.4

# 클라우드 임베딩 API (embedding_client.py)
EMBED_API_BASE_URL=
# EMBED_API_PATH=/api/v1/embed
# EMBED_API_VERIFY_TLS=true
# EMBED_API_TIMEOUT_SECONDS=30
# EMBEDDING_DIMENSION=768

# LLM (graph/model.py) — docker-compose 기본: /app/models/ 아래 GGUF 마운트
# LLM_MODEL_PATH=/app/models/qwen2-1_5b-instruct-q4_k_m.gguf
# LLM_N_GPU_LAYERS=0
# LLM_N_CTX=2048  # 로컬 recommend 프롬프트가 길면 4096 권장
# LLM_POPUP_DESC_CHARS_LOCAL=70   # RECOMMEND_LLM_BACKEND=local lean 프롬프트에서 팝업 설명 상한 (1.5B 모델 권장)
# 추천 답변 생성 시 신규 토큰 상한 (graph/nodes_generate.py, 기본 1024)
# LLM_GENERATE_MAX_TOKENS=1024
# generate 프롬프트에 넣는 팝업 description 최대 글자수(기본 480, 짧을수록 프리필·지연 감소)
# LLM_POPUP_DESC_CHARS=480

# 추천(generate) LLM — config/chat_llm.py
# RECOMMEND_LLM_BACKEND=local   # local | vertex (gemini 는 vertex 로 호환)
# LLM_GENERATE_MAX_TOKENS=1024
# LLM_POPUP_DESC_CHARS=480

# 의도·조건 JSON / 키워드·임베딩 문장 추출 LLM (graph/extract.py)
# EXTRACT_LLM_BACKEND=local     # local | vertex — RECOMMEND 와 독립 설정 가능
# EXTRACT_INTENT_MAX_TOKENS=200

# 타임아웃(초) — Vertex·Llama 호출·/chat 전체 상한 (과금·장시간 대기 방지)
# CHAT_REQUEST_TIMEOUT_SECONDS=40
# LLM_CALL_TIMEOUT_SECONDS=40

# LangGraph 체크포인트(userId=thread_id) 미사용 TTL — search_conditions·history 초기화 (기본 30분)
# CHAT_STATE_TTL_SECONDS=1800
# CHAT_STATE_TTL_SECONDS=0   # 비활성

# Vertex AI (RECOMMEND_LLM_BACKEND=vertex) — API 키 없음
# VERTEX_AI_PROJECT_ID=          # 또는 GOOGLE_CLOUD_PROJECT
# VERTEX_AI_LOCATION=asia-northeast3
# VERTEX_AI_MODEL=gemini-2.0-flash
# VERTEX_AI_TEMPERATURE=0.7
#
# 서비스 계정 JSON (git·Docker 이미지에 넣지 말 것)
# 1) GCP에서 키 발급 → secrets/gcp-vertex-sa.json 으로 저장 (cp secrets/gcp-vertex-sa.json.example 참고)
# 2) 로컬 uvicorn: 프로젝트 루트에서 실행 시 호스트 경로
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-vertex-sa.json
#
# 3) Docker (docker compose up): 호스트 키 경로만 지정. 컨테이너 경로는 compose가 고정
# GCP_SA_KEY_HOST_PATH=./secrets/gcp-vertex-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-sa.json
# (.env에 ./secrets/... 만 넣으면 컨테이너가 /app/secrets/... 를 찾다 실패함)
